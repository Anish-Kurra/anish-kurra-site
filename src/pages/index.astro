---
import Base from '../layouts/Base.astro';

// Placeholder content: replace with real bio, work, and links.
const links = [
  { label: 'GitHub', href: 'https://github.com/Anish-Kurra' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Email', href: '#' },
];

const projects = [
  { name: 'Project one', description: 'A short sentence about what it is and why it matters.', href: '#' },
  { name: 'Project two', description: 'A short sentence about what it is and why it matters.', href: '#' },
];
---
<Base>
  <h1>Anish Kurra</h1>
  <p class="muted">Builder. Placeholder tagline goes here.</p>

  <h2>About</h2>
  <p>
    A couple of sentences about who you are, what you work on, and what you care
    about. This is placeholder copy to be replaced.
  </p>

  <h2>Work</h2>
  <ul>
    {projects.map((p) => (
      <li>
        <a href={p.href}>{p.name}</a>
        <span class="muted"> · {p.description}</span>
      </li>
    ))}
  </ul>

  <h2>Elsewhere</h2>
  <ul>
    {links.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
</Base>
